                    {/* Chat Header */}
                    <div className="px-4 py-3 border-b border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-900/80 backdrop-blur-md flex items-center justify-between">
                      <div className="flex items-center space-x-3">
                        <div className="relative">
                          <div className="w-10 h-10 rounded-full bg-gradient-to-tr from-pink-400 to-purple-500 flex items-center justify-center text-white font-bold text-sm shadow-md">
                            A
                          </div>
                          <span className="absolute bottom-0 right-0 w-3 h-3 bg-emerald-500 rounded-full border-2 border-white dark:border-slate-900"></span>
                        </div>
                        <div>
                          <div className="flex items-center gap-1.5">
                            <h2 className="font-bold text-sm md:text-base text-slate-800 dark:text-slate-100">Alex</h2>
                            <span className="bg-purple-100 dark:bg-purple-900/50 text-purple-700 dark:text-purple-300 text-[10px] font-semibold px-2 py-0.5 rounded-full">
                              Mental4u AI Bestie
                            </span>
                          </div>
                          <p className="text-[11px] text-slate-500 dark:text-slate-400">
                            Always here • Listening & Vibe-Checking
                          </p>
                        </div>
                      </div>

                      <button
                        onClick={() => setShowSafetyModal(true)}
                        className="text-xs text-rose-600 dark:text-rose-400 bg-rose-50 dark:bg-rose-950/50 hover:bg-rose-100 border border-rose-200 dark:border-rose-900/50 px-2.5 py-1 rounded-lg flex items-center gap-1 transition font-medium"
                      >
                        <HelpCircle className="w-3.5 h-3.5" />
                        <span>Crisis Support</span>
                      </button>
                    </div>

                    {/* Messages Stream */}
                    <div className="flex-1 overflow-y-auto p-4 space-y-4">
                      {currentChat.messages.map((m) => {
                        const isUser = m.sender === 'user';
                        let emotionBadge = null;
                        let mainMessageText = m.text || '';

                        if (!isUser && mainMessageText.startsWith('[Feeling:')) {
                          const endBracketIdx = mainMessageText.indexOf(']');
                          if (endBracketIdx !== -1) {
                            emotionBadge = mainMessageText.substring(10, endBracketIdx).trim();
                            mainMessageText = mainMessageText.substring(endBracketIdx + 1).trim();
                          }
                        }

                        return (
                          <div
                            key={m.id}
                            className={`flex flex-col ${isUser ? 'items-end' : 'items-start'} space-y-1`}
                          >
                            {emotionBadge && (
                              <div className="flex items-center gap-1.5 px-3 py-1 rounded-full bg-gradient-to-r from-purple-100 to-pink-100 dark:from-purple-950 dark:to-pink-950 border border-purple-200 dark:border-purple-800 text-purple-700 dark:text-purple-300 text-[11px] font-semibold shadow-xs">
                                <Sparkles className="w-3 h-3 text-pink-500" />
                                <span>Alex {emotionBadge}</span>
                              </div>
                            )}

                            <div
                              className={`max-w-[85%] md:max-w-[75%] rounded-2xl p-3.5 shadow-sm text-sm leading-relaxed ${
                                isUser
                                  ? 'bg-gradient-to-r from-purple-600 to-indigo-600 text-white rounded-br-none'
                                  : 'bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 border border-slate-100 dark:border-slate-700/60 rounded-bl-none shadow-purple-500/5'
                              }`}
                            >
                              {m.image && (
                                <div className="mb-2 rounded-xl overflow-hidden border border-white/20 shadow-inner">
                                  <img src={m.image} alt="User upload" className="max-h-60 w-full object-cover" />
                                </div>
                              )}
                              <div className="whitespace-pre-wrap">{mainMessageText}</div>
                            </div>
                            <span className="text-[10px] text-slate-400 px-1">
                              {m.timestamp}
                            </span>
                          </div>
                        );
                      })}

                      {/* Typing Indicator */}
                      {isTyping && (
                        <div className="flex items-center space-x-2 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 px-4 py-2.5 rounded-2xl w-fit shadow-sm rounded-bl-none">
                          <div className="w-2 h-2 rounded-full bg-purple-500 animate-bounce"></div>
                          <div className="w-2 h-2 rounded-full bg-purple-500 animate-bounce [animation-delay:0.2s]"></div>
                          <div className="w-2 h-2 rounded-full bg-purple-500 animate-bounce [animation-delay:0.4s]"></div>
                          <span className="text-xs text-slate-400 font-medium ml-1">Alex is typing as your bestie...</span>
                        </div>
                      )}

                      <div ref={messagesEndRef} />
                    </div>

                    {/* Prompt Suggestions */}
                    {currentChat.messages.length <= 2 && (
                      <div className="px-4 py-2 flex items-center gap-2 overflow-x-auto no-scrollbar">
                        {SUGGESTED_PROMPTS.map((p, idx) => (
                          <button
                            key={idx}
                            onClick={() => handleSendMessage(p.text)}
                            className="shrink-0 bg-white dark:bg-slate-800 border border-purple-200 dark:border-slate-700 text-purple-700 dark:text-purple-300 text-xs px-3 py-1.5 rounded-full hover:bg-purple-50 dark:hover:bg-slate-700 transition shadow-sm"
                          >
                            {p.label}
                          </button>
                        ))}
                      </div>
                    )}

                    {/* Image Preview Bar */}
                    {imagePreview && (
                      <div className="px-4 py-2 bg-purple-50 dark:bg-slate-800/80 border-t border-slate-200 dark:border-slate-700 flex items-center justify-between">
                        <div className="flex items-center space-x-2">
                          <img src={imagePreview} alt="Preview" className="w-10 h-10 object-cover rounded-lg border border-purple-300" />
                          <span className="text-xs text-purple-700 dark:text-purple-300 font-medium">Screenshot attached</span>
                        </div>
                        <button
                          onClick={() => {
                            setSelectedImage(null);
                            setImagePreview(null);
                          }}
                          className="p-1 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200"
                        >
                          <X className="w-4 h-4" />
                        </button>
                      </div>
                    )}

                    {/* Input Bar */}
                    <div className="p-3 bg-white/90 dark:bg-slate-900/90 border-t border-slate-200 dark:border-slate-800 backdrop-blur-md">
                      <form
                        onSubmit={(e) => {
                          e.preventDefault();
                          handleSendMessage();
                        }}
                        className="flex items-center space-x-2"
                      >
                        <input
                          type="file"
                          ref={fileInputRef}
                          onChange={handleImageSelect}
                          accept="image/*"
                          className="hidden"
                        />
                        <button
                          type="button"
                          onClick={() => fileInputRef.current?.click()}
                          title="Upload photo or screenshot"
                          className="p-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-purple-100 dark:hover:bg-slate-700 hover:text-purple-600 transition"
                        >
                          <ImageIcon className="w-5 h-5" />
                        </button>

                        <input
                          type="text"
                          value={inputText}
                          onChange={(e) => setInputText(e.target.value)}
                          placeholder="Chat with Alex on Mental4u..."
                          className="flex-1 bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-100 placeholder-slate-400 rounded-xl px-4 py-2.5 text-sm outline-none focus:ring-2 focus:ring-purple-500/50 transition"
                        />

                        <button
                          type="submit"
                          disabled={!inputText.trim() && !selectedImage}
                          className="p-2.5 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 text-white font-semibold disabled:opacity-40 hover:opacity-90 shadow-md shadow-purple-500/20 transition"
                        >
                          <Send className="w-5 h-5" />
                        </button>
                      </form>
                    </div>
                  </main>
                </div>
              )}

              {/* TAB 2: MOOD JOURNAL */}
              {activeTab === 'mood' && (
                <div className="flex-1 p-4 md:p-6 overflow-y-auto space-y-6">
                  <div>
                    <h2 className="text-xl font-bold text-purple-600 dark:text-purple-400 flex items-center gap-2">
                      <Smile className="w-6 h-6" /> Daily Mood Check-In
                    </h2>
                    <p className="text-xs text-slate-500 dark:text-slate-400">
                      Track how you're feeling without judgment. Mental4u is here for your journey.
                    </p>
                  </div>

                  <div className="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm space-y-4">
                    <h3 className="text-sm font-semibold text-slate-700 dark:text-slate-200">How are you feeling right now?</h3>
                    
                    <div className="grid grid-cols-2 sm:grid-cols-4 gap-2">
                      {[
                        { label: '😊 Good', bg: 'hover:bg-emerald-50 hover:border-emerald-300' },
                        { label: '😌 Calm', bg: 'hover:bg-blue-50 hover:border-blue-300' },
                        { label: '😰 Anxious', bg: 'hover:bg-amber-50 hover:border-amber-300' },
                        { label: '😔 Sad / Low', bg: 'hover:bg-indigo-50 hover:border-indigo-300' },
                        { label: '😡 Frustrated', bg: 'hover:bg-rose-50 hover:border-rose-300' },
                        { label: '😴 Exhausted', bg: 'hover:bg-purple-50 hover:border-purple-300' },
                        { label: '✨ Excited', bg: 'hover:bg-pink-50 hover:border-pink-300' },
                        { label: '😶 Numb / Meh', bg: 'hover:bg-slate-100 hover:border-slate-400' }
                      ].map((m) => (
                        <button
                          key={m.label}
                          onClick={() => setSelectedMood(m.label)}
                          className={`p-3 rounded-xl border text-sm font-medium transition text-left flex items-center justify-between ${
                            selectedMood === m.label
                              ? 'border-purple-500 bg-purple-50 dark:bg-purple-950/60 text-purple-700 dark:text-purple-300 ring-2 ring-purple-500/20'
                              : `border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 ${m.bg}`
                          }`}
                        >
                          <span>{m.label}</span>
                          {selectedMood === m.label && <CheckCircle2 className="w-4 h-4 text-purple-600" />}
                        </button>
                      ))}
                    </div>

                    {selectedMood && (
                      <div className="space-y-3 pt-2">
                        <textarea
                          value={moodNote}
                          onChange={(e) => setMoodNote(e.target.value)}
                          placeholder="Add a quick note or vent about what made you feel this way (optional)..."
                          className="w-full bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl p-3 text-sm outline-none focus:ring-2 focus:ring-purple-500/40"
                          rows={3}
                        />
                        <button
                          onClick={handleAddMood}
                          className="bg-purple-600 hover:bg-purple-700 text-white font-semibold text-xs px-5 py-2.5 rounded-xl shadow-md transition"
                        >
                          Log Mood Entry
                        </button>
                      </div>
                    )}
                  </div>

                  <div className="space-y-3">
                    <h3 className="text-sm font-bold text-slate-700 dark:text-slate-200">Recent Mood Log History</h3>
                    <div className="space-y-2">
                      {moodLogs.map((entry) => (
                        <div
                          key={entry.id}
                          className="bg-white dark:bg-slate-800 p-3.5 rounded-xl border border-slate-200 dark:border-slate-700 flex justify-between items-center"
                        >
                          <div>
                            <span className="font-semibold text-sm text-slate-800 dark:text-slate-100">{entry.mood}</span>
                            <p className="text-xs text-slate-500 dark:text-slate-400 mt-0.5">{entry.note}</p>
                          </div>
                          <span className="text-[11px] text-slate-400 font-medium">{entry.date}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              )}

              {/* TAB 3: CALM CORNER */}
              {activeTab === 'calm' && (
                <div className="flex-1 p-6 flex flex-col items-center justify-center text-center space-y-6">
                  <div className="max-w-md space-y-2">
                    <h2 className="text-2xl font-bold text-purple-600 dark:text-purple-400 flex items-center justify-center gap-2">
                      <Wind className="w-6 h-6 animate-pulse" /> 4-7-8 Calm Breathing
                    </h2>
                    <p className="text-xs text-slate-500 dark:text-slate-400">
                      Follow the pulsating circle to reset your nervous system when feeling overwhelmed or anxious.
                    </p>
                  </div>

                  <div className="relative flex items-center justify-center w-56 h-56">
                    <div
                      className={`absolute inset-0 rounded-full bg-gradient-to-tr from-purple-400 via-pink-300 to-indigo-300 opacity-30 transition-all duration-1000 ${
                        isBreathingActive
                          ? breathingPhase === 'Inhale'
                            ? 'scale-125 duration-[4000ms]'
                            : breathingPhase === 'Hold'
                            ? 'scale-125 duration-[7000ms]'
                            : 'scale-90 duration-[8000ms]'
                          : 'scale-100'
                      }`}
                    />
                    <div className="w-44 h-44 rounded-full bg-white dark:bg-slate-800 border-4 border-purple-300 dark:border-purple-600 flex flex-col items-center justify-center shadow-xl z-10">
                      <span className="text-lg font-bold text-purple-600 dark:text-purple-300 uppercase tracking-widest">
                        {isBreathingActive ? breathingPhase : 'Ready?'}
                      </span>
                      {isBreathingActive && (
                        <span className="text-3xl font-black text-slate-800 dark:text-slate-100 mt-1">
                          {breathTimer}s
                        </span>
                      )}
                    </div>
                  </div>

                  <button
                    onClick={() => setIsBreathingActive(!isBreathingActive)}
                    className="bg-gradient-to-r from-purple-600 to-pink-600 text-white font-semibold px-6 py-3 rounded-xl shadow-lg hover:opacity-95 transition"
                  >
                    {isBreathingActive ? 'Pause Exercise' : 'Start Calm Breathing'}
                  </button>
                </div>
              )}

            </div>
          </div>

          {/* Settings Modal */}
          {showSettingsModal && (
            <div className="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
              <div className="bg-white dark:bg-slate-900 rounded-3xl max-w-md w-full p-6 shadow-2xl border border-slate-200 dark:border-slate-800 space-y-4">
                <div className="flex justify-between items-center">
                  <div className="flex items-center gap-2 text-purple-600 dark:text-purple-400 font-bold">
                    <Settings className="w-5 h-5" />
                    <span>Mental4u Settings</span>
                  </div>
                  <button onClick={() => setShowSettingsModal(false)} className="text-slate-400 hover:text-slate-600">
                    <X className="w-5 h-5" />
                  </button>
                </div>

                <p className="text-xs text-slate-500 leading-relaxed">
                  Mental4u works out-of-the-box with our local best-friend engine. If you want Alex powered by your custom Google Gemini API Key, enter it below:
                </p>

                <div className="space-y-2">
                  <label className="text-xs font-semibold text-slate-700 dark:text-slate-300 flex items-center gap-1">
                    <Key className="w-3.5 h-3.5" /> Optional Gemini API Key
                  </label>
                  <input
                    type="password"
                    value={userApiKey}
                    onChange={(e) => setUserApiKey(e.target.value)}
                    placeholder="AIzaSy..."
                    className="w-full bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-100 text-xs p-3 rounded-xl border border-slate-200 dark:border-slate-700 outline-none focus:ring-2 focus:ring-purple-500"
                  />
                </div>

                <div className="flex justify-between items-center pt-2">
                  <button
                    onClick={() => {
                      localStorage.removeItem('m4u_chats');
                      setChats(DEFAULT_CHATS);
                      setActiveChatId('default-1');
                      setShowSettingsModal(false);
                      triggerToast("Chat history cleared");
                    }}
                    className="text-xs text-rose-500 hover:underline flex items-center gap-1"
                  >
                    <RefreshCw className="w-3.5 h-3.5" /> Clear All Chat History
                  </button>

                  <button
                    onClick={() => setShowSettingsModal(false)}
                    className="bg-purple-600 text-white px-4 py-2 rounded-xl text-xs font-semibold shadow-md"
                  >
                    Save & Close
                  </button>
                </div>
              </div>
            </div>
          )}

          {/* Crisis Support Modal */}
          {showSafetyModal && (
            <div className="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
              <div className="bg-white dark:bg-slate-900 rounded-3xl max-w-lg w-full p-6 shadow-2xl border border-rose-100 dark:border-slate-800 space-y-5">
                <div className="flex justify-between items-start">
                  <div className="flex items-center gap-3">
                    <div className="p-3 bg-rose-100 dark:bg-rose-950/60 rounded-2xl text-rose-600">
                      <PhoneCall className="w-6 h-6" />
                    </div>
                    <div>
                      <h3 className="font-bold text-lg text-slate-800 dark:text-slate-100">Immediate Crisis Support</h3>
                      <p className="text-xs text-slate-500">Free, confidential & available 24/7 for you.</p>
                    </div>
                  </div>
                  <button
                    onClick={() => setShowSafetyModal(false)}
                    className="p-1 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200"
                  >
                    <X className="w-5 h-5" />
                  </button>
                </div>

                <p className="text-xs text-slate-600 dark:text-slate-300 leading-relaxed bg-rose-50/80 dark:bg-rose-950/30 p-3 rounded-xl border border-rose-100 dark:border-rose-900/40">
                  Mental4u cares deeply about your safety. If you or someone you know is struggling or in distress, help is always available:
                </p>

                <div className="space-y-2">
                  {CRISIS_RESOURCES.map((res, i) => (
                    <a
                      key={i}
                      href={res.link}
                      className="block p-3.5 rounded-2xl border border-slate-200 dark:border-slate-800 hover:border-purple-300 dark:hover:border-purple-700 hover:bg-purple-50/50 dark:hover:bg-slate-800 transition"
                    >
                      <div className="flex justify-between items-center mb-1">
                        <span className="font-bold text-sm text-slate-800 dark:text-slate-100">{res.name}</span>
                        <span className="text-xs font-semibold text-purple-600 dark:text-purple-400 bg-purple-100 dark:bg-purple-950 px-2 py-0.5 rounded-full">
                          {res.contact}
                        </span>
                      </div>
                      <p className="text-xs text-slate-500 dark:text-slate-400">{res.desc}</p>
                    </a>
                  ))}
                </div>

                <div className="pt-2 flex justify-end">
                  <button
                    onClick={() => setShowSafetyModal(false)}
                    className="bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 px-4 py-2 rounded-xl text-xs font-semibold hover:bg-slate-200 transition"
                  >
                    Back to Mental4u
                  </button>
                </div>
              </div>
            </div>
          )}

        </div>
      );
    }

    ReactDOM.createRoot(document.getElementById('root')).render(<App />);
  </script>
</body>
</html>
