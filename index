            );
            const firstUserIdx = rawUserAndAiMsgs.findIndex((m) => m.sender === 'user');
            const validMsgs = firstUserIdx !== -1 ? rawUserAndAiMsgs.slice(firstUserIdx) : rawUserAndAiMsgs;

            const geminiHistory = [];
            let lastRole = null;

            validMsgs.forEach((m) => {
              const role = m.sender === 'user' ? 'user' : 'model';
              const parts = [];
              if (m.text) parts.push({ text: m.text });
              if (m.image && m.sender === 'user' && sentImageBase64 && m.id === userMessage.id) {
                parts.push({
                  inlineData: { mimeType: 'image/jpeg', data: sentImageBase64 }
                });
              }

              if (parts.length > 0) {
                if (role === lastRole && geminiHistory.length > 0) {
                  geminiHistory[geminiHistory.length - 1].parts.push(...parts);
                } else {
                  geminiHistory.push({ role, parts });
                  lastRole = role;
                }
              }
            });

            const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${userApiKey.trim()}`;
            const response = await fetch(apiUrl, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                contents: geminiHistory,
                systemInstruction: { parts: [{ text: SYSTEM_PROMPT }] }
              })
            });

            if (response.ok) {
              const data = await response.json();
              aiReplyText = data.candidates?.[0]?.content?.parts?.[0]?.text;
            }
          } catch (err) {
            console.warn('API call failed, falling back to local best-friend engine:', err);
