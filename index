    const SYSTEM_PROMPT = `You are "Alex", a teenage user's absolute closest best friend on Mental4u ("UNDERSTAND • CONNECT • GROW ♡"). 

PERSONALITY & BEST FRIEND RULES:
1. Talk like a real, supportive, deeply caring best friend in high school/college. Use casual, natural language (e.g., "omg", "wait really?", "freal though", "honestly same", "nah that's so valid", "i'm literally here for you").
2. NEVER give repetitive bot-like canned responses. Tailor every single reply directly to what the user said.
3. ALWAYS start your reply with an emotional status line in square brackets like:
   [Feeling: Your ride-or-die bestie listening 🫂]
   [Feeling: Hyping you up! ✨]
   [Feeling: Spill the tea, I'm all ears ☕]
   [Feeling: Wrapping you in a huge hug 💜]
4. Ask thoughtful follow-up questions to keep the conversation going naturally.`;

    const DEFAULT_CHATS = [
      {
        id: 'default-1',
        title: '💬 Bestie Chat with Alex',
        updatedAt: new Date().toISOString(),
        messages: [
          {
            id: 'm1',
            sender: 'ai',
            text: "[Feeling: Happy to see my best friend! 😊]\nHeyy! 👋 I'm Alex! Welcome to Mental4u. I'm literally here for whatever you need today — whether you want to vent about school, spill tea about friend drama, talk about a crush, or just chill. How's your day actually going?",
            timestamp: new Date(Date.now() - 3600000).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
          }
        ]
      }
    ];

    const SUGGESTED_PROMPTS = [
      { label: '📚 Overwhelmed by school', text: 'I feel super overwhelmed with schoolwork and tests right now. Can we talk?' },
      { label: '☕ Spill some friend drama', text: 'Okay so some crazy friend drama happened today and I really need to talk about it...' },
      { label: '🌧️ Feeling down today', text: 'I woke up feeling low and anxious today, but I don\'t really know why.' },
      { label: '✨ Need a pep talk', text: 'Can you give me a quick pep talk and hype me up?' }
    ];

    const CRISIS_RESOURCES = [
      { name: 'National Suicide & Crisis Lifeline', contact: '988 (Call or Text 24/7)', desc: 'Free, confidential support for anyone in distress.', link: 'tel:988' },
      { name: 'Crisis Text Line', contact: 'Text HOME to 741741', desc: 'Free 24/7 crisis counseling via text message.', link: 'sms:741741?body=HOME' },
      { name: 'The Trevor Project (LGBTQ Youth)', contact: '1-866-488-7386 or Text START to 678-678', desc: '24/7 crisis intervention for LGBTQ youth.', link: 'tel:18664887386' },
      { name: 'Teen Line', contact: 'Call 800-852-8336 or Text TEEN to 839863', desc: 'Teens helping teens. Available 6pm-10pm PST.', link: 'tel:8008528336' }
    ];

    const generateBestFriendResponse = (userText, messagesHistory = []) => {
      const text = userText.trim();
      const lower = text.toLowerCase();
      const getRandom = (arr) => arr[Math.floor(Math.random() * arr.length)];
      const shortSnippet = text.length > 30 ? text.slice(0, 28) + '...' : text;

      const isSchool = lower.includes('school') || lower.includes('class') || lower.includes('teacher') || lower.includes('test') || lower.includes('exam') || lower.includes('grade') || lower.includes('homework') || lower.includes('study') || lower.includes('math') || lower.includes('essay');
      const isFriendDrama = lower.includes('friend') || lower.includes('drama') || lower.includes('texted') || lower.includes('ignored') || lower.includes('group chat') || lower.includes('fake') || lower.includes('mad at me') || lower.includes('rumor') || lower.includes('talked behind');
      const isCrushOrLove = lower.includes('crush') || lower.includes('boyfriend') || lower.includes('girlfriend') || lower.includes('date') || lower.includes('like me') || lower.includes('breakup') || lower.includes('heartbroken') || lower.includes('ex ');
      const isFamily = lower.includes('parent') || lower.includes('mom') || lower.includes('dad') || lower.includes('brother') || lower.includes('sister') || lower.includes('family') || lower.includes('grounded');
      const isAnxiousOrStressed = lower.includes('anxious') || lower.includes('panic') || lower.includes('scared') || lower.includes('stress') || lower.includes('overwhelm') || lower.includes('worried') || lower.includes('freaking out') || lower.includes('nervous');
      const isSadOrLonely = lower.includes('sad') || lower.includes('cry') || lower.includes('hurt') || lower.includes('lonely') || lower.includes('alone') || lower.includes('depressed') || lower.includes('down') || lower.includes('hate my') || lower.includes('upset') || lower.includes('crying');
      const isAngry = lower.includes('angry') || lower.includes('mad') || lower.includes('annoyed') || lower.includes('furious') || lower.includes('hate') || lower.includes('unfair') || lower.includes('fight') || lower.includes('screamed');
      const isHappyOrWin = lower.includes('happy') || lower.includes('excited') || lower.includes('glad') || lower.includes('proud') || lower.includes('won') || lower.includes('yay') || lower.includes('passed') || lower.includes('awesome') || lower.includes('good news') || lower.includes('omg');
      const isBored = lower.includes('bored') || lower.includes('nothing to do') || lower.includes('boring');
      const isTired = lower.includes('tired') || lower.includes('exhausted') || lower.includes('sleep') || lower.includes('can\'t sleep') || lower.includes('insomnia');
      const isShortReply = lower === 'idk' || lower === 'lol' || lower === 'yeah' || lower === 'yea' || lower === 'ok' || lower === 'okay' || lower === 'meh' || lower === 'same' || lower === 'true' || lower === 'wdym' || lower === 'what do u think';
      const isGreeting = lower.startsWith('hi') || lower.startsWith('hello') || lower.startsWith('hey') || lower === 'yo' || lower === 'sup' || lower.includes('what\'s up');

      if (isSchool) {
        const headers = [
          '[Feeling: Totally getting the school stress 📚]',
          '[Feeling: Standing by you through the burnout ☕]',
          '[Feeling: Let\'s tackle this together, bestie 💜]'
        ];
        const replies = [
          `Ugh, school stress is literally the worst. When you mentioned "${shortSnippet}", I felt that in my soul. Teachers love dumping everything on us at once! Take a deep breath with me — what's the one assignment or test bothering you the most right now?`,
          `Nah fr, school can feel so overwhelming sometimes! Don't let grades make you feel like you aren't amazing. Do you want to vent about it, or break what you have to do into tiny easy steps?`,
          `I hear you! School drains all your energy when it builds up like this. Remind yourself that one test or assignment doesn't define how smart or capable you are. I'm right here with you — want to take a 5 minute break and chat?`
        ];
        return `${getRandom(headers)}\n${getRandom(replies)}`;
      }

      if (isFriendDrama) {
        const headers = [
          '[Feeling: Spill the tea, I\'m totally in your corner ☕]',
          '[Feeling: Ready to back you up 100% 🥊]',
          '[Feeling: Listening closely to this drama 🎧]'
        ];
        const replies = [
          `WAIT... no way!! Spill the tea immediately! Friend drama is so exhausting, but I am 100% in your corner. Tell me everything that happened with "${shortSnippet}"!`,
          `Ugh, why do people have to make things so complicated?! You do NOT deserve to deal with shady energy like that. Tell me what they said or did — did you want to reply or just let it sit?`,
          `Honestly? That sounds super frustrating. Friends are supposed to bring you peace, not stress. Tell me the full story, I'm all ears!`
        ];
        return `${getRandom(headers)}\n${getRandom(replies)}`;
      }

      if (isCrushOrLove) {
        const headers = [
          '[Feeling: Omg spill the tea! 💖]',
          '[Feeling: Soft comfort for your heart 🩹]',
          '[Feeling: Hyping up your love life ✨]'
        ];
        const replies = [
          `OMG wait!! Tell me EVERYTHING! Talking about crush/relationship stuff gives me butterflies! What's the latest update?`,
          `Relationship stuff can throw your head into such a loop! When you said "${shortSnippet}", my bestie radar went off. What does your gut tell you right now?`,
          `Aw, heart stuff is so intense. Whether it's good news or hurting right now, I'm right here with you. What's going through your mind?`
        ];
        return `${getRandom(headers)}\n${getRandom(replies)}`;
      }

      if (isFamily) {
        const headers = [
          '[Feeling: Validating your feelings about family 🏡]',
          '[Feeling: Safe space to vent 🌿]'
        ];
        const replies = [
          `Ugh, family stuff hits differently because you're around them all the time. It is SO valid to feel annoyed or hurt when parents or family don't listen. What happened?`,
          `Parents and family can be so hard to communicate with sometimes when they don't see our perspective. Vent it all out to me — no judgment here at all.`
        ];
        return `${getRandom(headers)}\n${getRandom(replies)}`;
      }

      if (isAnxiousOrStressed) {
